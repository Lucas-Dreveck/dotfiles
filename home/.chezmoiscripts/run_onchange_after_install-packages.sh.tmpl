#!/bin/sh
{{- $osID := .chezmoi.os }}
{{- if hasKey .chezmoi.osRelease "id" }}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id }}
{{- end }}
{{- if ne $osID "linux-arch" }}

printf 'install-packages: %s sem lista de pacotes definida\n' '{{ $osID }}' >&2
{{- else }}
{{- $pacman := list
      "age"
      "chezmoi"
      "fastfetch"
      "git"
      "gnupg"
      "gopass"
      "kitty"
      "nvm"
      "perl"
      "rustup"
      "starship"
      "ttf-jetbrains-mono-nerd"
      "util-linux"
      "uv"
      "vim"
      "wl-clipboard"
      "zsh" }}
{{- $aur := list }}
{{- $uvtools := list }}
{{- if .work }}
{{-   $pacman = mustAppend $pacman "docker" }}
{{-   $aur = mustAppend $aur "hadolint-bin" }}
{{-   $uvtools = concat $uvtools (list "black" "djlint" "flake8" "isort") }}
{{- end }}

set -eu

pacman_pkgs="{{ $pacman | sortAlpha | join " " }}"
aur_pkgs="{{ $aur | sortAlpha | join " " }}"
uv_tools="{{ $uvtools | sortAlpha | join " " }}"

missing=""
for p in $pacman_pkgs; do
    pacman -Qq "$p" >/dev/null 2>&1 || missing="$missing $p"
done
if [ -n "$missing" ]; then
    printf 'install-packages: pacman ->%s\n' "$missing"
    sudo pacman -S --needed --noconfirm $missing
fi

missing=""
for p in $aur_pkgs; do
    pacman -Qq "$p" >/dev/null 2>&1 || missing="$missing $p"
done
if [ -n "$missing" ]; then
    if command -v yay >/dev/null 2>&1; then
        printf 'install-packages: yay ->%s\n' "$missing"
        yay -S --needed --noconfirm $missing
    else
        printf 'install-packages: yay ausente, faltando ->%s\n' "$missing" >&2
    fi
fi

missing=""
for p in $uv_tools; do
    uv tool list 2>/dev/null | grep -v '^-' | cut -d' ' -f1 | grep -qx "$p" || missing="$missing $p"
done
if [ -n "$missing" ]; then
    printf 'install-packages: uv tool ->%s\n' "$missing"
    for p in $missing; do uv tool install "$p"; done
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -z "$(ls -A "$NVM_DIR/versions/node" 2>/dev/null)" ]; then
    printf 'install-packages: nvm -> node lts\n'
    bash -c '. /usr/share/nvm/nvm.sh && nvm install --lts && nvm alias default "lts/*"'
fi

if [ -z "$(ls -A "${RUSTUP_HOME:-$HOME/.rustup}/toolchains" 2>/dev/null)" ]; then
    printf 'install-packages: rustup -> stable\n'
    rustup default stable
fi
{{- end }}
