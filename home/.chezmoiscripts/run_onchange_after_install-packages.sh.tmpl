#!/bin/sh
{{- $osID := .chezmoi.os }}
{{- if hasKey .chezmoi.osRelease "id" }}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id }}
{{- end }}
{{- if ne $osID "linux-arch" }}

printf 'install-packages: no package list defined for %s\n' '{{ $osID }}' >&2
{{- else }}
{{- $pacman := .pacman.common }}
{{- $aur := .aur.common }}
{{- $uvtools := .uv.common }}
{{- if .personal }}
{{-   $pacman = concat $pacman .pacman.personal }}
{{-   $aur = concat $aur .aur.personal }}
{{-   $uvtools = concat $uvtools .uv.personal }}
{{- end }}
{{- if .work }}
{{-   $pacman = concat $pacman .pacman.work }}
{{-   $aur = concat $aur .aur.work }}
{{-   $uvtools = concat $uvtools .uv.work }}
{{- end }}

set -eu

failed=""

pacman_pkgs="{{ $pacman | sortAlpha | join " " }}"
aur_pkgs="{{ $aur | sortAlpha | join " " }}"
uv_tools="{{ $uvtools | sortAlpha | join " " }}"

missing=$(pacman -T $pacman_pkgs 2>/dev/null || true)
if [ -n "$missing" ]; then
    known=""
    unknown=""
    for p in $missing; do
        if pacman -Si "$p" >/dev/null 2>&1; then
            known="$known $p"
        else
            unknown="$unknown $p"
        fi
    done
    if [ -n "$unknown" ]; then
        printf 'install-packages: not in the repos ->%s\n' "$unknown" >&2
        failed="$failed pacman-unknown"
    fi
    if [ -n "$known" ]; then
        printf 'install-packages: pacman ->%s\n' "$known"
        sudo pacman -S --needed --noconfirm $known || failed="$failed pacman"
    fi
fi

missing=""
for p in $aur_pkgs; do
    pacman -Qq "$p" >/dev/null 2>&1 || missing="$missing $p"
done
if [ -n "$missing" ]; then
    if command -v yay >/dev/null 2>&1; then
        printf 'install-packages: yay ->%s\n' "$missing"
        yay -S --needed --noconfirm $missing || failed="$failed yay"
    else
        printf 'install-packages: yay missing, still needed ->%s\n' "$missing" >&2
        failed="$failed yay-missing"
    fi
fi

if [ -n "$uv_tools" ]; then
    if command -v uv >/dev/null 2>&1; then
        missing=""
        for p in $uv_tools; do
            uv tool list 2>/dev/null | grep -v '^-' | cut -d' ' -f1 | grep -qx "$p" || missing="$missing $p"
        done
        if [ -n "$missing" ]; then
            printf 'install-packages: uv tool ->%s\n' "$missing"
            for p in $missing; do
                uv tool install "$p" || failed="$failed uv:$p"
            done
        fi
    else
        printf 'install-packages: uv missing, still needed -> %s\n' "$uv_tools" >&2
        failed="$failed uv-missing"
    fi
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -z "$(ls -A "$NVM_DIR/versions/node" 2>/dev/null)" ]; then
    if [ -r /usr/share/nvm/nvm.sh ]; then
        printf 'install-packages: nvm -> node lts\n'
        bash -c '. /usr/share/nvm/nvm.sh && nvm install --lts && nvm alias default "lts/*"' ||
            failed="$failed nvm"
    else
        echo 'install-packages: nvm missing, node lts not installed' >&2
        failed="$failed nvm-missing"
    fi
fi

if [ -z "$(ls -A "${RUSTUP_HOME:-$HOME/.rustup}/toolchains" 2>/dev/null)" ]; then
    if command -v rustup >/dev/null 2>&1; then
        printf 'install-packages: rustup -> stable\n'
        rustup default stable || failed="$failed rustup"
    else
        echo 'install-packages: rustup missing, toolchain not installed' >&2
        failed="$failed rustup-missing"
    fi
fi

if [ -n "$failed" ]; then
    printf 'install-packages: incomplete ->%s\n' "$failed" >&2
    exit 1
fi
{{- end }}
