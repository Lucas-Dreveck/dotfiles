#!/bin/sh
{{- $osID := .chezmoi.os }}
{{- if hasKey .chezmoi.osRelease "id" }}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id }}
{{- end }}
{{- if ne $osID "linux-arch" }}

printf 'install-packages: %s sem lista de pacotes definida\n' '{{ $osID }}' >&2
{{- else }}
{{- $pacman := list
      "age"
      "chezmoi"
      "fastfetch"
      "git"
      "gnupg"
      "gopass"
      "kitty"
      "nvm"
      "perl"
      "starship"
      "ttf-jetbrains-mono-nerd"
      "util-linux"
      "vim"
      "wl-clipboard"
      "zsh" }}
{{- $aur := list }}
{{- $pipx := list }}
{{- if .work }}
{{-   $pacman = mustAppend $pacman "docker" }}
{{-   $aur = mustAppend $aur "hadolint-bin" }}
{{-   $pipx = concat $pipx (list "black" "djlint" "flake8" "isort") }}
{{- end }}

set -eu

pacman_pkgs="{{ $pacman | sortAlpha | join " " }}"
aur_pkgs="{{ $aur | sortAlpha | join " " }}"
pipx_pkgs="{{ $pipx | sortAlpha | join " " }}"

missing=""
for p in $pacman_pkgs; do
    pacman -Qq "$p" >/dev/null 2>&1 || missing="$missing $p"
done
if [ -n "$missing" ]; then
    printf 'install-packages: pacman ->%s\n' "$missing"
    sudo pacman -S --needed --noconfirm $missing
fi

missing=""
for p in $aur_pkgs; do
    pacman -Qq "$p" >/dev/null 2>&1 || missing="$missing $p"
done
if [ -n "$missing" ]; then
    if command -v yay >/dev/null 2>&1; then
        printf 'install-packages: yay ->%s\n' "$missing"
        yay -S --needed --noconfirm $missing
    else
        printf 'install-packages: yay ausente, faltando ->%s\n' "$missing" >&2
    fi
fi

missing=""
for p in $pipx_pkgs; do
    pipx list --short 2>/dev/null | cut -d' ' -f1 | grep -qx "$p" || missing="$missing $p"
done
if [ -n "$missing" ]; then
    if command -v pipx >/dev/null 2>&1; then
        printf 'install-packages: pipx ->%s\n' "$missing"
        for p in $missing; do pipx install "$p"; done
    else
        printf 'install-packages: pipx ausente, faltando ->%s\n' "$missing" >&2
    fi
fi
{{- end }}
